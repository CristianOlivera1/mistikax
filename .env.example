# Supabase Postgres for application data (phase 4)
DATABASE_URL=
DIRECT_URL=

# Supabase Auth (phase 6)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Supabase Storage for runtime uploads; the private bucket is created on first upload
SUPABASE_STORAGE_BUCKET=mistikax-media

# Legacy local uploads read fallback (no new files are written here)
UPLOAD_DIR=./storage/uploads

# Guest cart signing secret (phase 7)
CART_COOKIE_SECRET=

# Canonical public origin for OAuth redirects and sitemap
NEXT_PUBLIC_SITE_URL=
